# Google Cloud OAuth client (Credentials -> OAuth client ID -> Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Obtained ONCE by running `npm run get-refresh-token` (see README.md).
# This authorizes the app to create events on the coach's calendar forever,
# without any further manual approval.
GOOGLE_REFRESH_TOKEN=

# Usually "primary" if using the coach's own calendar, or a specific
# calendar's ID (Calendar settings -> Integrate calendar -> Calendar ID).
GOOGLE_CALENDAR_ID=primary
